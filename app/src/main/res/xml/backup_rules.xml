<!--
    Auto Backup rules for API 30 and below. The API 31+ equivalent lives in
    data_extraction_rules.xml; see the note there for why birth data is excluded.
-->
<full-backup-content>
    <exclude domain="database" path="astroveda_database" />
    <exclude domain="database" path="astroveda_database-shm" />
    <exclude domain="database" path="astroveda_database-wal" />
    <exclude domain="sharedpref" path="astroveda_prefs.xml" />
</full-backup-content>
