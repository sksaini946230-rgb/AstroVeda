<?xml version="1.0" encoding="utf-8"?>
<!--
    Both this file and backup_rules.xml were the untouched Android Studio
    templates — every rule commented out — while allowBackup was true. That meant
    the Room database, which holds saved birth profiles (name, date of birth,
    exact time of birth, birth place and coordinates), was uploaded to the user's
    Google Drive backup and copied on device transfer. The database is not
    encrypted, so that data sat in a backup in the clear.

    Birth details are the most personal thing this app holds. They are excluded
    from both cloud backup and device transfer. Signed-in users already have an
    explicit, opt-in cloud copy in Firestore; nobody needs a silent second one.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="astroveda_database" />
        <exclude domain="database" path="astroveda_database-shm" />
        <exclude domain="database" path="astroveda_database-wal" />
        <!-- Holds is_pro and the selected city; neither should ride a backup. -->
        <exclude domain="sharedpref" path="astroveda_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="astroveda_database" />
        <exclude domain="database" path="astroveda_database-shm" />
        <exclude domain="database" path="astroveda_database-wal" />
        <exclude domain="sharedpref" path="astroveda_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
